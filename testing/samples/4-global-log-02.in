# Check that global-log prints out commits that are no longer in any branch.
# FIXME: kludged around problem with regular-expression pattern characters in
#        log.
I setup2.inc
# Kludge starts.
D DATE1 "Date: \w{3} \w{3} \d{2} \d{2}:\d{2}:\d{2} \d{4}"
D COMMIT_LOG "(===\ncommit [a-f0-9]{40}\n(?:Merge: [0-9a-f]{7} [0-9a-f]{7}\n)?${DATE1}) [-+](\d{4}\n(?:.|\n)*?(?=\Z|\n===))"
+ h.txt wug.txt
> add h.txt
<<<
> commit "Add h"
<<<
> log
${COMMIT_LOG}
${COMMIT_LOG}
${COMMIT_LOG}
<<<*
D L1 "${1} [-+]${2}"
> log
===
${COMMIT_HEAD}
Add h

===
${COMMIT_HEAD}${ARBLINES}
<<<*
D ID "${2}"
> reset ${ID}
<<<
> global-log
${ARBLINES}${L1}?${ARBLINES}
<<<*
